# Copy this file to .env and fill in real values for local development.
# In production, set these as real environment variables / platform secrets
# instead of shipping a .env file.

# Required in production - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Shared secret between this server and the ESP32 firmware. The ESP32 sends
# this on every check-in so the server knows it's the real device, not a
# stranger hitting /device/sync. Generate with:
#   python -c "import secrets; print(secrets.token_hex(16))"
# and paste the same value into DEVICE_API_KEY in SmartHome.ino.
DEVICE_API_KEY=change-me-to-a-random-hex-string

# How many seconds without a check-in before the dashboard shows the ESP32
# as offline. Should be a few times your firmware's POLL_INTERVAL_MS.
DEVICE_OFFLINE_AFTER=10

# Seed admin account created on first run (only if the users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to true only for local HTTP development; keep true (default) in production over HTTPS
SESSION_COOKIE_SECURE=false

# Optional: set to true for local debugging only, never in production
FLASK_DEBUG=false

# Optional: override where the SQLite file lives
# DATABASE_PATH=/data/users.db

PORT=5000
